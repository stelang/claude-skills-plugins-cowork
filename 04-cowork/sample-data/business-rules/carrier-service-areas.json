    "rule_3_fragile_exclusions": {
      "description": "Exclude Economy Freight for fragile items",
      "logic": "If fragile=Yes, exclude Economy Freight from consideration"
    },

    "rule_4_value_based_selection": {
      "description": "High-value items should use premium carriers",
      "logic": "If value_usd > 1000, prefer FedEx/UPS/DHL over Economy Freight"
    },

